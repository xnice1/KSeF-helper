STAGING_DOMAIN=staging.example.com
STAGING_SITE_ADDRESS=staging.example.com
PUBLIC_BASE_URL=https://staging.example.com
CORS_ALLOWED_ORIGINS=https://staging.example.com
ACME_EMAIL=ops@example.com

BACKEND_IMAGE=ghcr.io/example/ksef-helper-backend
FRONTEND_IMAGE=ghcr.io/example/ksef-helper-frontend
IMAGE_TAG=staging

POSTGRES_DB=ksef_helper
POSTGRES_BOOTSTRAP_USER=ksef_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=replace-with-a-long-random-secret
DB_MIGRATION_ROLE=ksef_migrator
DB_MIGRATION_PASSWORD=replace-with-a-long-random-secret
DB_RUNTIME_ROLE=ksef_runtime
DB_RUNTIME_PASSWORD=replace-with-a-long-random-secret
DB_AUDIT_MAINTENANCE_ROLE=ksef_audit_maintainer
DB_AUDIT_MAINTENANCE_PASSWORD=replace-with-a-long-random-secret

REDIS_PASSWORD=replace-with-a-long-random-secret

S3_ACCESS_KEY=ksef-helper-app
S3_SECRET_KEY=replace-with-a-different-long-random-secret
S3_BUCKET=ksef-helper-staging
S3_REGION=eu-central-1
S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
S3_PATH_STYLE_ACCESS=false
S3_SERVER_SIDE_ENCRYPTION=AES256

JWT_SECRET=replace-with-base64-encoded-random-32-byte-or-longer-secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=staging@example.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true
MAIL_FROM=KSeF Helper Staging <staging@example.com>

SENTRY_DSN=https://public-key@example.ingest.sentry.io/project-id
SENTRY_TRACES_SAMPLE_RATE=0.1

ALERT_SMTP_SMARTHOST=smtp.example.com:587
ALERT_SMTP_USERNAME=staging@example.com
ALERT_SMTP_PASSWORD=replace-with-smtp-password
ALERT_SMTP_REQUIRE_TLS=true
ALERT_EMAIL_FROM=staging@example.com
ALERT_EMAIL_TO=ops@example.com

AUDIT_PERSONAL_DATA_DAYS=90
AUDIT_RETENTION_DAYS=365
INVOICE_RETENTION_DAYS=0
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError
